# Copia este archivo como .env y cambia los valores.

# Base de datos (Docker)
POSTGRES_DB=nova_event
POSTGRES_USER=nova
POSTGRES_PASSWORD=cambia-esta-clave
DB_PORT=5433

# Para "npm run dev" fuera de Docker (apunta a la base de datos del contenedor)
DATABASE_URL=postgres://nova:cambia-esta-clave@localhost:5433/nova_event

# Primer administrador (se crea una sola vez al iniciar)
ADMIN_EMAIL=admin@novaevent.com
ADMIN_PASSWORD=cambia-esta-clave-tambien
ADMIN_NAME=Administrador

# Imágenes en ghcr.io: tu usuario u organización de GitHub, en minúsculas (obligatorio en el servidor)
GHCR_OWNER=felipe4563

# App
APP_PORT=3000
# true en el servidor con HTTPS. Pon false solo si entras por http:// con una IP (sin dominio ni HTTPS).
COOKIE_SECURE=true
