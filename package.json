{
  "name": "nova-event",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs push",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:demo": "tsx --env-file-if-exists=.env src/db/demo.ts",
    "db:studio": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pannellum": "2.5.7",
    "postgres": "^3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
